[Unit]
Description=recyclarr
After=network-online.target
Wants=network-online.target

[Container]
ContainerName=recyclarr
Image=ghcr.io/recyclarr/recyclarr
Environment=PUID=1005
Environment=PGID=1005
Environment=UMASK=002
Environment=TZ="Etc/UTC"
Volume=/var/swarm/home/containers/recyclarr/config:/config:Z
Network=web.network
AutoUpdate=registry

[Service]
Restart=always

[Install]
WantedBy=default.target
