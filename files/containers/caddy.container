[Unit]
Description=caddy
After=network-online.target
Wants=network-online.target

[Container]
ContainerName=caddy
Image=docker.io/library/caddy
Network=web.network
Environment=CERTBOT_EMAIL=----snip----
Volume=/var/swarm/home/containers/caddy/Caddyfile:/etc/caddy/Caddyfile:Z
Volume=/var/swarm/home/containers/caddy/srv:/srv:ro,Z
Volume=/var/swarm/home/containers/caddy/data:/data:Z
Volume=/var/swarm/home/containers/caddy/config:/config:Z
PublishPort=80:80/tcp
PublishPort=443:443/tcp
PublishPort=80:80/udp
PublishPort=443:443/udp
PublishPort=8448:8448/tcp
PublishPort=8448:8448/udp
AutoUpdate=registry

[Service]
Restart=always

[Install]
WantedBy=default.target
