[Unit]
Description=frigate
After=network-online.target
Wants=network-online.target

[Container]
ContainerName=frigate
Image=ghcr.io/blakeblackshear/frigate:stable
Volume=/var/swarm/home/containers/frigate/config:/config:Z
Volume=/var/swarm/home/containers/frigate/localtime:/etc/localtime:ro
Volume=/var/swarm/home/containers/frigate/media:/media/frigate
Mount=type=tmpfs,target=/tmp/cache,tmpfs-size=1000000000
PodmanArgs=--privileged --group-add keep-groups
#AddDevice=/dev/bus/usb:/dev/bus/usb
AddDevice=/dev/dri/card0:/dev/dri/card0
AddCapability=CAP_PERFMON
Network=web.network
AutoUpdate=registry
PublishPort=8971:8971
PublishPort=8554:8554
#PublishPort=5000:5000
PublishPort=8555:8555/tcp
PublishPort=8555:8555/udp
PublishPort=1984:1984
Environment=FRIGATE_RTSP_PASSWORD=----snip----
Environment=FRIGATE_MQTT_USER=hass
Environment=FRIGATE_MQTT_PASSWORD=----snip----
Environment=FRIGATE_DOORBELL_PASSWORD=----snip----
Environment=PLUS_API_KEY=----snip----
StopTimeout=30
ShmSize=512m

[Service]
Restart=always
TimeoutStopSec=40

[Install]
WantedBy=default.target
