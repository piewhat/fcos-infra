[Unit]
Description=lk-jwt
After=network-online.target
Wants=network-online.target

[Container]
ContainerName=lk-jwt
Image=ghcr.io/element-hq/lk-jwt-service:0.1.2
Network=web.network
AutoUpdate=registry
Environment=LIVEKIT_URL="ws://livekit"
Environment=LIVEKIT_KEY=devkey
Environment=LIVEKIT_SECRET=----snip----

[Service]
Restart=always

[Install]
WantedBy=default.target
