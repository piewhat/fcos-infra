[Unit]
Description=radarr4k
After=network-online.target qbittorrent.service
Wants=network-online.target

[Container]
ContainerName=radarr4k
Image=ghcr.io/hotio/radarr:release
PublishPort=7888:7878
Environment=PUID=1005
Environment=PGID=1005
Environment=UMASK=002
Environment=TZ="Etc/UTC"
Volume=/var/swarm/media/other/arr:/data:z
Volume=/var/swarm/home/containers/radarr4k/config:/config:Z
Network=web.network
AutoUpdate=registry

[Service]
Restart=always

[Install]
WantedBy=default.target
