[Unit]
Description=cleanuparr
After=network-online.target
Wants=network-online.target

[Container]
#ContainerName=cleanuparr
#Image=ghcr.io/cleanuparr/cleanuparr:latest
PublishPort=11011:11011
Environment=PUID=1005
Environment=PGID=1005
Environment=UMASK=002
Environment=TZ="Etc/UTC"
Environment=PORT=11011
Environment=BASE_PATH=
Volume=/var/swarm/media/other/arr:/downloads:z
Volume=/var/swarm/home/containers/cleanuparr/config:/config:Z
Network=web.network
AutoUpdate=registry

[Service]
Restart=always

[Install]
WantedBy=default.target

