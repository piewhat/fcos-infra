[Unit]
Description=lavalink
After=network-online.target
Wants=network-online.target

[Container]
ContainerName=lavalink
Image=ghcr.io/lavalink-devs/lavalink:4-alpine
Network=web.network
Volume=/var/swarm/home/containers/lavalink/application.yml:/opt/Lavalink/application.yml:Z
Volume=/var/swarm/home/containers/piebot/quotes:/quotes:z
PublishPort=2333:8080
Environment=_JAVA_OPTIONS=-Xmx6G
Environment=LAVALINK_SERVER_PASSWORD=----snip----
AutoUpdate=registry

[Service]
Restart=always

[Install]
WantedBy=default.target
