[Unit]
Description=jellyseerr
After=network-online.target
Wants=network-online.target

[Container]
ContainerName=prowlarr
Image=ghcr.io/hotio/prowlarr:release
PublishPort=9696:9696
Environment=PUID=1005
Environment=PGID=1005
Environment=UMASK=002
Environment=TZ="Etc/UTC"
Volume=/var/swarm/media/other/arr:/data:z
Volume=/var/swarm/home/containers/prowlarr/config:/config:Z
Network=web.network
AutoUpdate=registry

[Service]
Restart=always

[Install]
WantedBy=default.target

