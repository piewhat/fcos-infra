[Unit]
Description=Plex Media Server
After=network-online.target
Wants=network-online.target

[Container]
ContainerName=plex
Image=docker.io/plexinc/pms-docker
PublishPort=32400:32400
Environment=PLEX_UID=1005
Environment=PLEX_GID=1005
Timezone=America/New_York
Volume=/var/swarm/home/containers/plex/config:/config:Z
Volume=/var/swarm/home/containers/plex/transcode:/transcode:Z
Volume=/var/swarm/media:/data:z
AutoUpdate=registry
AddDevice=/dev/dri:/dev/dri
Environment=LIBVA_DRIVER_NAME=iHD

[Service]
Restart=always

[Install]
WantedBy=default.target
