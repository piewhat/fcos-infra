[Unit]
Description=seerr
After=network-online.target
Wants=network-online.target

[Container]
ContainerName=seerr
Image=ghcr.io/seerr-team/seerr:latest
PublishPort=5055:5055
Volume=/var/swarm/home/containers/seerr/config:/app/config:Z
Network=web.network
AutoUpdate=registry

[Service]
Restart=always

[Install]
WantedBy=default.target
