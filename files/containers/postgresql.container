[Unit]
Description=postgresql
After=network-online.target
Wants=network-online.target

[Container]
ContainerName=postgres
Image=docker.io/library/postgres:16.1
Network=web.network
Environment=POSTGRES_PASSWORD=----snip----
Volume=/var/swarm/home/containers/postgresql:/var/lib/postgresql/data:Z
PublishPort=5432:5432
AutoUpdate=registry

[Service]
Restart=always

[Install]
WantedBy=default.target
