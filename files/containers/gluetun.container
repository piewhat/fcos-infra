[Unit]
Description=gluetun
After=network-online.target
Wants=network-online.target

[Container]
ContainerName=gluetun
Image=ghcr.io/qdm12/gluetun

Volume=/var/swarm/home/containers/gluetun/config:/gluetun:z
Volume=/var/swarm/home/containers/gluetun/port:/tmp/gluetun:Z

PublishPort=8888:8888
PublishPort=8388:8388/tcp
PublishPort=8388:8388/udp

#qBittorrent
PublishPort=8080:8080
PublishPort=6881:6881
PublishPort=6881:6881/udp

Environment=VPN_PORT_FORWARDING=on
Environment=VPN_PORT_FORWARDING_PROVIDER='----snip----'
Environment=VPN_PORT_FORWARDING_USERNAME=----snip----
Environment=VPN_PORT_FORWARDING_PASSWORD='----snip----'
Environment=UPDATER_PERIOD=24h
Environment=SERVER_NAMES=toronto434
#Environment=SERVER_REGIONS='----snip----'
Environment=BLOCK_MALICIOUS=off
Environment=VPN_SERVICE_PROVIDER=custom
Environment=VPN_TYPE=wireguard
Environment=WIREGUARD_ENDPOINT_IP=----snip----
Environment=WIREGUARD_ENDPOINT_PORT=1337
Environment=WIREGUARD_PUBLIC_KEY=----snip----
Environment=WIREGUARD_PRIVATE_KEY=----snip----
Environment=WIREGUARD_ADDRESSES=----snip----
Environment=TZ="Etc/UTC"
PodmanArgs=--privileged
AddCapability=NET_ADMIN,NET_RAW,MKNOD
Network=web.network
AutoUpdate=registry

[Service]
Restart=always

[Install]
WantedBy=default.target
