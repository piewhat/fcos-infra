[Unit]
Description=transmission openvpn
After=network-online.target
Wants=network-online.target

[Container]
ContainerName=transmission-openvpn
Image=docker.io/haugene/transmission-openvpn
PublishPort=9092:9091
Environment=OPENVPN_PROVIDER='----snip----'
Environment=OPENVPN_CONFIG='----snip----'
Environment=OPENVPN_USERNAME=----snip----
Environment=OPENVPN_PASSWORD='----snip----'
Environment=TRANSMISSION_WEB_UI=flood-for-transmission
Environment=CREATE_TUN_DEVICE=false
Environment=PUID=1005
Environment=PGID=1005
Environment=UMASK=002
LogDriver=k8s-file
Volume=/var/swarm/media/other/arr:/data:z
Volume=/var/swarm/home/containers/transmission/config:/config:Z
PodmanArgs=--privileged
AddCapability=NET_ADMIN,NET_RAW,MKNOD
Network=web.network
AutoUpdate=registry

[Service]
Restart=always

[Install]
WantedBy=default.target
