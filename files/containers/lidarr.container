[Unit]
Description=lidarr
After=network-online.target qbittorrent.service
Wants=network-online.target

[Container]
ContainerName=lidarr
Image=ghcr.io/hotio/lidarr
PublishPort=8686:8686
Environment=PUID=1005
Environment=PGID=1005
Environment=UMASK=002
Environment=TZ="Etc/UTC"
Volume=/var/swarm/media/other/arr:/data:z
Volume=/var/swarm/home/containers/lidarr/config:/config:Z
Network=web.network
AutoUpdate=registry

[Service]
Restart=always

[Install]
WantedBy=default.target
