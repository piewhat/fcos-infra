[Unit]
Description=home-assistant
After=network-online.target
Wants=network-online.target

[Container]
ContainerName=home-assistant
Image=ghcr.io/home-assistant/home-assistant:stable
Volume=/var/swarm/home/containers/home-assistant/config:/config:Z
Volume=/var/swarm/home/containers/home-assistant/localtime:/etc/localtime:ro
Volume=/run/dbus:/run/dbus:ro
PodmanArgs=--privileged
Network=web.network
AutoUpdate=registry
PublishPort=8123:8123
StopTimeout=30
ShmSize=512m

[Service]
Restart=always
TimeoutStopSec=40

[Install]
WantedBy=default.target
