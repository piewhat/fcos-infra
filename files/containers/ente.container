[Unit]
Description=ente
After=network-online.target
Wants=network-online.target

[Container]
ContainerName=ente
Image=ghcr.io/ente-io/server:latest
PublishPort=8081:8080
Volume=/var/swarm/home/containers/museum/data:/data:Z
Volume=/var/swarm/home/containers/museum/museum.yaml:/museum.yaml:ro,Z
Network=web.network
AutoUpdate=registry

[Service]
Restart=always

[Install]
WantedBy=default.target
