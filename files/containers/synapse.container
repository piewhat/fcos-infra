[Unit]
Description=synapse
After=network-online.target postgresql.service
Wants=network-online.target

[Container]
ContainerName=synapse_new
Image=docker.io/matrixdotorg/synapse
Network=web.network
Volume=/var/swarm/home/containers/synapse_new:/data:Z
PublishPort=8009:8009
AutoUpdate=registry

[Service]
Restart=always

[Install]
WantedBy=default.target
