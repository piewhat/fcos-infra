[Unit]
Description=mc-server
After=network-online.target
Wants=network-online.target

[Container]
ContainerName=mc
Image=mc:latest
Timezone=America/New_York
Volume=/var/swarm/home/containers/minecraft:/opt/minecraft:Z
AutoUpdate=local
PodmanArgs=--stop-timeout=120
PublishPort=25565:25565/udp
PublishPort=25565:25565/tcp

[Service]
Restart=always
TimeoutStopSec=200

[Install]
WantedBy=default.target
