[Unit]
Description=navidrome
After=network-online.target
Wants=network-online.target

[Container]
ContainerName=navidrome
Image=docker.io/deluan/navidrome
Network=host
Volume=/var/swarm/home/containers/navidrome:/data:Z
Volume=/var/swarm/media:/music:z,ro
AutoUpdate=registry

[Service]
Restart=always

[Install]
WantedBy=default.target
