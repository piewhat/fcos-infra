  links:
    - path: /etc/systemd/user/timers.target.wants/podman-auto-update.timer
      target: /usr/lib/systemd/user/podman-auto-update.timer
    - path: /etc/systemd/system/multi-user.target.wants/smb.service
      target: /usr/lib/systemd/system/smb.service
      hard: false
    - path: /etc/systemd/system/multi-user.target.wants/wsdd.service
      target: /usr/lib/systemd/system/wsdd.service
      hard: false
